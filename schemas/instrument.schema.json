{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Keywise Instrument Catalog",
  "type": "object",
  "required": ["schema_version", "catalog_version", "instruments"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": { "type": ["string", "null"], "format": "date-time" },
    "instruments": {
      "type": "array",
      "items": { "$ref": "#/$defs/instrument" }
    }
  },
  "$defs": {
    "instrument": {
      "type": "object",
      "required": ["id", "name", "version", "description", "license", "source", "package"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "author": { "type": ["string", "null"] },
        "license": {
          "type": "object",
          "required": ["spdx_id", "redistribution_verified", "attribution"],
          "properties": {
            "spdx_id": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"], "format": "uri" },
            "redistribution_verified": { "const": true },
            "attribution": { "type": "string" },
            "notes": { "type": "string" }
          },
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "revision": { "type": ["string", "null"] },
            "retrieved_at": { "type": ["string", "null"], "format": "date" }
          },
          "additionalProperties": false
        },
        "package": {
          "type": "object",
          "required": ["url", "sha256", "format", "size_bytes"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
            "format": { "enum": ["zip", "tar", "tar.gz", "tar.bz2", "tar.xz"] },
            "size_bytes": { "type": "integer", "minimum": 1 },
            "top_level_directory": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "sfz_files": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
